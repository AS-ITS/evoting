{
    "name": "voting/app",
    "description": "Electronic voting platform (Yii2), MIT licensed. Dialogs use kartik-v/yii2-dialog and Bootstrap 5 Modal",
    "keywords": [
        "yii2",
        "voting",
        "e-voting"
    ],
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.0.0",
        "ext-mbstring": "*",
        "ext-ctype": "*",
        "lib-pcre": "*",
        "yiisoft/yii2": "^2.0",
        "yiisoft/yii2-bootstrap5": "^2.0",
        "yiisoft/yii2-symfonymailer": "~3.0.0",
        "yiisoft/yii2-jui": "~2.0.0",
        "yiisoft/yii2-composer": "~2.0.4",
        "bower-asset/jquery": "3.6.*@stable | 3.5.*@stable | 3.4.*@stable | 3.3.*@stable | 3.2.*@stable | 3.1.*@stable | 2.2.*@stable | 2.1.*@stable | 1.11.*@stable | 1.12.*@stable",
        "bower-asset/jquery-ui": "~1.12.1",
        "bower-asset/inputmask": "^5.0.8",
        "bower-asset/punycode": "^2.2",
        "bower-asset/yii2-pjax": "~2.0.1",
        "ezyang/htmlpurifier": "~4.6",
        "paragonie/random_compat": ">=1",
        "kartik-v/yii2-krajee-base": "@dev",
        "kartik-v/yii2-grid": "dev-master",
        "kartik-v/yii2-editable": "@dev",
        "kartik-v/yii2-widget-select2": "@dev",
        "kartik-v/yii2-dialog": "dev-master",
        "cebe/markdown": "~1.0.0 | ~1.1.0 | ~1.2.0",
        "rmrevin/yii2-fontawesome": "~3.5",
        "spomky-labs/otphp": "^11.5",
        "phpoffice/phpword": "^1.4",
        "as-its-dev3/yii2-dynamicform": "~2.0",
        "phpoffice/phpspreadsheet": "^5.0",
        "endroid/qr-code": "^6.0",
        "bower-asset/adminlte": "v3.1.0",
        "kartik-v/yii2-bootstrap5-dropdown": "@dev"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "phpunit/phpunit": "^9.6.11",
        "codeception/codeception": "^5.1",
        "codeception/lib-innerbrowser": "^4.0 || ^3.0 || ^1.1",
        "codeception/module-asserts": "^3.0 || ^1.1",
        "codeception/module-yii2": "^1.1",
        "codeception/module-filesystem": "^3.0 || ^2.0 || ^1.1",
        "codeception/verify": "^3.2",
        "symfony/browser-kit": "^6.0 || >=2.7 <=4.2.4",
        "codeception/module-phpbrowser": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php scripts/apply-vendor-patches.php"
        ],
        "post-update-cmd": [
            "@php scripts/apply-vendor-patches.php"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
